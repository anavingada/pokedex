{
  "files": [],
  "references": [{ "path": "./tsconfig.node.json" }, { "path": "./tsconfig.app.json" }],
  "compilerOptions": {
    // Module system for Node/EcmaScript interop
    "module": "NodeNext",

    // JS for Vite / Vue 3
    "target": "ESNext",

    // Strictness options
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    // Silence deprecation warnings from TS 6+
    "ignoreDeprecations": "6.0"
  }
}
