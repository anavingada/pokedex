{
  "extends": "@tsconfig/node20/tsconfig.json",
  "include": ["vite.config.*", "nightwatch.conf.*", "playwright.config.*"],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",

    // Node scripts
    "module": "ESNext",
    "moduleResolution": "bundler",

    // Node typings
    "types": ["node"],

    // Silence deprecation warnings from TS 6+
    "ignoreDeprecations": "6.0",

    // Strictness options
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  }
}
